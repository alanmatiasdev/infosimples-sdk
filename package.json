{
  "name": "infosimples-sdk",
  "version": "0.6.0",
  "description": "A forma mais fácil e rápida de integrar o InfoSimples na sua aplicação Node.JS",
  "keywords": [
    "infosimples",
    "sdk",
    "nodejs",
    "node",
    "infosimples-sdk"
  ],
  "main": "dist/index.js",
  "repository": "git@github.com:alanmatiasdev/infosimples-sdk.git",
  "author": "Alan Matias <me@alanmatias.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.19.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
